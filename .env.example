# Copy to .env and adjust. Every value is optional.

# ---- Network exposure ----
# Interface the dashboard listens on. 0.0.0.0 = whole LAN (TLS + sign-in protect it).
# Use 127.0.0.1 if only a local reverse proxy should reach it.
DASHBOARD_BIND=0.0.0.0
DASHBOARD_PORT=8443
HTTP_PORT=8080
# Admin panel: always bound to 127.0.0.1. Reach it from elsewhere with an SSH tunnel:
#   ssh -L 8444:127.0.0.1:8444 you@server
ADMIN_PORT=8444

# Extra names/IPs for the self-signed certificate (comma-separated),
# e.g. scanner.lan,192.168.1.20. Ignored if you mount your own cert.
TLS_SANS=

# ---- Reverse proxy ----
# IPs/CIDRs of reverse proxies in front of this stack. Only these may set
# X-Forwarded-For (used for the audit log and rate limiting).
TRUSTED_PROXIES=
# redirect: port 8080 redirects to https (default)
# proxy:    port 8080 serves the dashboard over plain HTTP to TRUSTED_PROXIES only
#           (for proxies that terminate TLS themselves); everyone else gets 403
HTTP_MODE=redirect
# Fixed host name for the http->https redirect (default: the request's Host)
PUBLIC_HOST=

# ---- First admin account ----
# Leave ADMIN_PASSWORD empty to get a generated one in `docker compose logs scanner`
# (you must change it at first sign-in). If set, it needs 12+ characters.
ADMIN_USER=admin
ADMIN_PASSWORD=

# ---- Scanner ----
DEFAULT_ENGINE=trivy        # trivy | grype | both (only used on first start)
OFFLINE=                    # 1 = never download DBs/feeds (air-gapped)
METRICS_TOKEN=              # bearer token for Prometheus on the admin port
SCANNER_MEM_LIMIT=2g
TZ=UTC

# ---- Build inputs ----
# Trivy and Grype are compiled from source with the newest Go and patched
# libraries, so the scanner's own images stay clean. Bump these to upgrade.
# TRIVY_VERSION=v0.76.1
# GRYPE_VERSION=v0.121.0
# WITH_GRYPE=true          # false = Trivy only, smaller image
# Base images (point at a mirror if Docker Hub rate-limits you)
# GO_IMAGE=golang:1.27-alpine
# NGINX_IMAGE=nginx:alpine
